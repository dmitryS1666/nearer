# Public site hostname (Caddy / docs).
DOMAIN=nearer.other.dev-regiuslab.by
ACME_EMAIL=ops@example.com

# Host port for the nearer nginx container ONLY.
# On regiuslab-de: 3007 is taken by izokom — use 3011.
APP_PORT=3011

# Plus purchase-intent mail. Leave PLUS_MAIL_MODE empty until SMTP is ready.
# Do not set PLUS_MAIL_MODE=test in production: the server refuses that mode.
# PLUS_MAIL_MODE=smtp
# PLUS_NOTIFY_TO=dsuschinsky@gmail.com
# PLUS_MAIL_FROM=nearer@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=0
